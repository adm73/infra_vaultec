# Image published by .github/workflows/docker-build.yml.
VAULTEC_IMAGE=ghcr.io/adm73/infra_vaultec:latest

# Keep the application behind an HTTPS reverse proxy by default.
PUBLIC_URL=https://vaultec.ai
BIND_ADDRESS=127.0.0.1
HOST_PORT=3001
TZ=UTC
NODE_NAME=vaultec-server-1

# Replace every value below with a different random secret before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
CRYPTO_SECRET=replace-with-at-least-32-random-bytes
